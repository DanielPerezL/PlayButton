# Copia este fichero a .env y sustituye TODOS los valores antes de desplegar.
# Genera los secretos con, por ejemplo:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# Contraseña del usuario administrador que se crea al inicializar la base de datos
ADMIN_PASSWORD=cambia-esta-contrasena

# Secretos de la aplicación: NO reutilices el mismo valor en ambos
SECRET_KEY=cambia-esta-clave
JWT_SECRET_KEY=cambia-esta-clave-jwt

# Base de datos MySQL
MYSQL_ROOT_PASSWORD=cambia-esta-contrasena-root
MYSQL_DATABASE_NAME=play-button
MYSQL_USER=playbutton
MYSQL_PASSWORD=cambia-esta-contrasena-db
DATABASE_HOST=mysql_db_playbutton

# Activa CORS solo si sirves el frontend desde un origen distinto al backend
CORS_ENABLED=false
